# Netlify Cache Control Headers for Dieting Bondhu PWA

# Service worker & version check must never be cached by the browser
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

# Main HTML pages must always revalidate so new deploys are loaded immediately
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Web App Manifest
/manifest.json
  Cache-Control: public, max-age=3600

# Immutable static media & icons
/icon-192.png
  Cache-Control: public, max-age=31536000, immutable
/icon-512.png
  Cache-Control: public, max-age=31536000, immutable
/icon.svg
  Cache-Control: public, max-age=31536000, immutable
